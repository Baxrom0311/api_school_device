#######################
# SECRET KEY
#######################
SECRET_KEY=django-insecure-change-this-in-production-use-strong-key


#######################
# POSTGRES DB
#######################
POSTGRES_DB=iot_school_device
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


#######################
# DEBUG
#######################
DEBUG=False


#######################
# HOSTS
#######################
ALLOWED_HOSTS=localhost,127.0.0.1,web,your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-dashboard.com


######################
# PORTS
######################
PORT=8000
CELERY_FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:change_this_password
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4


######################
# Redis & Celery
######################
REDIS_ENABLED=true
REDIS_PASSWORD=change_this_redis_password
REDIS_CACHE_URL=redis://:change_this_redis_password@redis:6379/1
REDIS_URL=redis://:change_this_redis_password@redis:6379/0
CACHE_TIMEOUT=300
CELERY_BROKER=redis://:change_this_redis_password@redis:6379/0


######################
# EMQX MQTT Broker
######################
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_USERNAME=backend_service
MQTT_PASSWORD=change_mqtt_password_here
MQTT_CLIENT_ID=django-publisher
MQTT_LISTENER_CLIENT_ID=django-mqtt-listener
MQTT_USE_TLS=false
MQTT_AUTH_SECRET=change_this_shared_secret_for_emqx_http_auth

# EMQX Dashboard & Node
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change_dashboard_password
EMQX_NODE_COOKIE=change_this_emqx_cookie

# Device offline threshold (seconds)
DEVICE_OFFLINE_THRESHOLD=300


######################
# SENTRY (Optional - set SENTRY_ENABLED=true to activate)
######################
SENTRY_ENABLED=false
# SENTRY_DSN=https://<YOUR_SENTRY_DSN>@sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production


######################
# Email (SMTP)
######################
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@schooldevice.uz