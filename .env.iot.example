# ===========================================
# IoT Device Management - Environment Variables
# ===========================================

# Django
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://dashboard.your-domain.com,https://app.your-domain.com

# Database
POSTGRES_DB=iot_devices
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=secure-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MQTT Broker (EMQX)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=django_backend
MQTT_PASSWORD=mqtt-secure-password
MQTT_CLIENT_ID=django-publisher
MQTT_LISTENER_CLIENT_ID=django-listener
MQTT_USE_TLS=false

# For TLS/SSL MQTT (production)
# MQTT_BROKER_PORT=8883
# MQTT_USE_TLS=true

# Device Settings
DEVICE_OFFLINE_THRESHOLD=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis Cache
REDIS_URL=redis://localhost:6379/1

# Sentry (optional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@schooldevice.uz

# OTA Server
OTA_SERVER_URL=https://your-domain.com
FIRMWARE_STORAGE_PATH=/var/www/firmware
